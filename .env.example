# Copy to .env and fill in. Never commit the filled-in file.

PORT=8080

# Local development: Postgres in docker compose (`make db`).
#
# Keep development on a local database even though production is Neon. Every
# round trip to Neon is ~32ms against ~0.3ms locally, and this suite spends most
# of its time on round trips inside transactions — the full run goes from about
# 45 seconds to over twenty minutes. Correctness is identical; only the wait is
# not.
DATABASE_URL=postgres://billsplit:billsplit@localhost:5433/billsplit?sslmode=disable

# Production: Neon, ap-southeast-1.
#
# Use the DIRECT endpoint, never the one with `-pooler` in the host. The pooled
# endpoint is pgbouncer: today it runs in transaction mode, where
# `pg_advisory_xact_lock` and `set_config(..., true)` both survive because both
# are transaction-scoped — but nothing in our code would notice if that ever
# changed, and a session-mode pooler silently reopens the guard that took seven
# review rounds to close. There is no upside to accept: MaxConns is 10 and this
# app has no use for a pooler.
#
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# LINE Login channel — the channel your LIFF app belongs to.
# ID tokens are pinned to this value, so a token minted for another app is
# rejected rather than accepted as one of your users.
LINE_CHANNEL_ID=

# Messaging API channel — a DIFFERENT channel from the one above.
# Needed only to push the settlement summary back into a LINE chat.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Permanent link to the LIFF app, used for the button in the Flex summary.
LIFF_URL=https://liff.line.me/0000000000-xxxxxxxx

# Origins allowed to call this API, comma separated. The frontend runs on a
# different origin, so this is load-bearing, not optional.
ALLOWED_ORIGINS=http://localhost:5173
